{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical Engineering Evidence Map",
  "type": "object",
  "required": ["evidence"],
  "properties": {"evidence": {"type": "array", "minItems": 1, "items": {
    "type": "object",
    "required": ["evidence_id", "source", "processing_step", "state_change", "technical_effect", "effect_basis", "status"],
    "properties": {
      "evidence_id": {"type": "string", "pattern": "^E[0-9]{3,}$"},
      "source": {"type": "object", "required": ["path", "sha256"], "properties": {
        "path": {"type": "string", "minLength": 1}, "symbol": {"type": "string"},
        "start_line": {"type": "integer", "minimum": 1}, "end_line": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }, "additionalProperties": false},
      "processing_step": {"type": "string", "minLength": 4},
      "state_change": {"type": "string", "minLength": 4},
      "technical_effect": {"type": "string", "minLength": 4},
      "effect_basis": {"enum": ["measured", "observed", "mechanism-derived"]},
      "status": {"enum": ["code-supported", "document-supported", "experiment-supported"]},
      "snapshot_id": {"type": "string", "pattern": "^S[0-9]{3,}$"},
      "engineering_iteration_id": {"type": "string", "pattern": "^IT[0-9]{3,}$"},
      "proposal_id": {"type": "string", "pattern": "^SP[0-9]{3,}$"},
      "validation_status": {"enum": ["not_run", "passed", "failed", "other_sufficient"]},
      "novelty_distinction_eligible": {"type": "boolean"}
    }, "additionalProperties": false
  }}},
  "additionalProperties": false
}
