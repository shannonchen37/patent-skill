{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical Application Draft Metadata",
  "type": "object",
  "required": [
    "source_claims_v2_sha256",
    "claims_final_sha256",
    "specification_final_sha256",
    "abstract_sha256",
    "drawings_description_sha256",
    "limitation_sync"
  ],
  "properties": {
    "source_claims_v2_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "claims_final_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "specification_final_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "abstract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "drawings_description_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "limitation_sync": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "limitation_id",
          "specification_sections",
          "terminology_synced",
          "protected_subject_synced",
          "embodiment_supported",
          "technical_effect_supported",
          "drawing_reference_status",
          "status"
        ],
        "properties": {
          "limitation_id": {"type": "string", "pattern": "^I[1-9][0-9]*-L[1-9][0-9]*$"},
          "specification_sections": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "terminology_synced": {"const": true},
          "protected_subject_synced": {"const": true},
          "embodiment_supported": {"const": true},
          "technical_effect_supported": {"const": true},
          "drawing_reference_status": {"enum": ["checked", "not_applicable"]},
          "status": {"const": "synced"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
