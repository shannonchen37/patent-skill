{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Structured Final Patent Audit",
  "type": "object",
  "required": ["audited_application", "novelty", "inventive_step", "eligibility", "clarity_and_support", "enablement", "unity", "amendment_basis", "sensitive_information", "unimplemented_disclosures"],
  "$defs": {
    "status": {"enum": ["PASS", "RISK", "ATTORNEY_REVIEW_REQUIRED"]},
    "review": {"type": "object", "required": ["status", "conclusion", "evidence_refs", "residual_risk", "recommended_action"], "properties": {
      "status": {"$ref": "#/$defs/status"}, "conclusion": {"type": "string", "minLength": 8},
      "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
      "residual_risk": {"type": "string", "minLength": 4}, "recommended_action": {"type": "string", "minLength": 4}
    }, "additionalProperties": false}
  },
  "properties": {
    "audited_application": {"type": "object", "required": ["revision", "claims_final_sha256", "specification_final_sha256", "abstract_sha256", "drawings_manifest_sha256"], "properties": {
      "revision": {"type": "integer", "minimum": 0},
      "claims_final_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "specification_final_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "abstract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "drawings_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    }, "additionalProperties": false},
    "novelty": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object", "required": ["status", "closest_reference_ids", "single_reference_full_disclosure", "conclusion", "evidence_refs", "residual_risk", "recommended_action"], "properties": {
      "status": {"$ref": "#/$defs/status"}, "closest_reference_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
      "single_reference_full_disclosure": {"type": "boolean"}, "conclusion": {"type": "string", "minLength": 8},
      "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
      "residual_risk": {"type": "string", "minLength": 4}, "recommended_action": {"type": "string", "minLength": 4}
    }, "additionalProperties": false}},
    "inventive_step": {"type": "object", "required": ["status", "closest_prior_art", "distinguishing_limitation_ids", "technical_effects", "objective_technical_problem", "combination_motivation", "conclusion", "evidence_refs", "residual_risk", "recommended_action"], "properties": {
      "status": {"$ref": "#/$defs/status"}, "closest_prior_art": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
      "distinguishing_limitation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^I[0-9]+-L[0-9]+$"}},
      "technical_effects": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 4}},
      "objective_technical_problem": {"type": "string", "minLength": 8}, "combination_motivation": {"type": "string", "minLength": 8},
      "conclusion": {"type": "string", "minLength": 8}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
      "residual_risk": {"type": "string", "minLength": 4}, "recommended_action": {"type": "string", "minLength": 4}
    }, "additionalProperties": false},
    "eligibility": {"$ref": "#/$defs/review"}, "clarity_and_support": {"$ref": "#/$defs/review"},
    "enablement": {"$ref": "#/$defs/review"}, "unity": {"$ref": "#/$defs/review"},
    "amendment_basis": {"$ref": "#/$defs/review"}, "sensitive_information": {"$ref": "#/$defs/review"},
    "unimplemented_disclosures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["disclosure_id", "used_in_limitations", "enablement_status", "implementation_status"],
        "properties": {
          "disclosure_id": {"type": "string", "pattern": "^TD[0-9]{3,}$"},
          "used_in_limitations": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^(I|D)[0-9]+-L[0-9]+$"}
          },
          "enablement_status": {"const": "sufficient"},
          "implementation_status": {"enum": ["partially_implemented", "designed_not_implemented"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
