{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical Claim Support Map",
  "type": "object",
  "required": ["limitations"],
  "properties": {"limitations": {"type": "array", "minItems": 1, "items": {
    "type": "object",
    "required": ["limitation_id", "claim_id", "engineering_evidence_ids", "technical_disclosure_ids", "specification_sections", "technical_effect", "effect_basis", "status"],
    "properties": {
      "limitation_id": {"type": "string", "pattern": "^(I|D)[0-9]+-L[0-9]+$"},
      "claim_id": {"type": "string", "pattern": "^(I|D)[0-9]+$"},
      "engineering_evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^E[0-9]{3,}$"}},
      "technical_disclosure_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^TD[0-9]{3,}$"}},
      "specification_sections": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
      "technical_effect": {"type": "string", "minLength": 4},
      "effect_basis": {"enum": ["measured", "observed", "mechanism-derived"]},
      "status": {"const": "supported"}
    },
    "anyOf": [
      {"properties": {"engineering_evidence_ids": {"minItems": 1}}},
      {"properties": {"technical_disclosure_ids": {"minItems": 1}}}
    ],
    "additionalProperties": false
  }}},
  "additionalProperties": false
}
