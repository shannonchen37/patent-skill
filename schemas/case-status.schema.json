{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical Patent Case Status",
  "type": "object",
  "$defs": {
    "stage": {"enum": ["PROJECT_SNAPSHOT", "EVIDENCE_MAP", "INVENTION_CANDIDATES", "FIRST_SEARCH", "CANDIDATE_RANKING", "FEATURE_MATRIX", "CLAIMS_V1", "SPECIFICATION_V1", "SUPPORT_CANDIDATES", "CLAIMS_V2", "CLAIM_SUPPORT_MAP", "FINAL_SEARCH", "APPLICATION_DRAFT", "FINAL_AUDIT", "CONTENT_READY_FOR_ATTORNEY_REVIEW", "INDEPENDENT_AUDIT", "DOCX_PACKAGE_RENDERED"]}
  },
  "required": [
    "canonical_source",
    "case_dir",
    "project_source",
    "current_stage",
    "revision",
    "revision_history",
    "stage_history",
    "external_roles"
  ],
  "properties": {
    "canonical_source": {"const": "patent-skill"},
    "case_dir": {"type": "string", "minLength": 1},
    "project_source": {"type": "string", "minLength": 1},
    "proposed_title": {"type": "string"},
    "current_stage": {"$ref": "#/$defs/stage"},
    "revision": {"type": "integer", "minimum": 0},
    "revision_history": {"type": "array", "items": {"type": "object", "required": ["revision_id", "reopened_stage", "reason", "trigger", "created_at", "archived_under"], "properties": {
      "revision_id": {"type": "string", "pattern": "^R[0-9]{3,}$"}, "reopened_stage": {"$ref": "#/$defs/stage"},
      "reason": {"type": "string", "minLength": 1}, "trigger": {"$ref": "#/$defs/stage"},
      "created_at": {"type": "string", "format": "date-time"}, "archived_under": {"type": "string", "minLength": 1}
    }, "additionalProperties": false}},
    "stage_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["stage", "entered_at", "event", "revision"],
        "properties": {
          "stage": {"$ref": "#/$defs/stage"},
          "entered_at": {"type": "string", "format": "date-time"},
          "event": {"enum": ["initialize", "advance", "revise"]},
          "revision": {"type": "integer", "minimum": 0},
          "reason": {"type": "string"},
          "trigger": {"$ref": "#/$defs/stage"}
        }
      }
    },
    "external_roles": {
      "type": "object",
      "required": ["yjmm10/patent-skills", "HuangXinzhe/cn-patent-drafting"],
      "properties": {
        "yjmm10/patent-skills": {"const": "CNIPA_SEARCH_ONLY"},
        "HuangXinzhe/cn-patent-drafting": {"const": "INDEPENDENT_AUDIT_AND_DOCX_ONLY"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
