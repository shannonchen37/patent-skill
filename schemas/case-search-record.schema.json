{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical Case Search Record",
  "type": "object",
  "required": [
    "record_id",
    "database",
    "search_date",
    "query",
    "candidate_id",
    "result_count",
    "reviewed_reference_ids",
    "verified_urls",
    "coverage_limitations"
  ],
  "properties": {
    "record_id": {"type": "string", "pattern": "^S[0-9]+$"},
    "database": {"type": "string", "minLength": 2},
    "search_date": {"type": "string", "format": "date"},
    "query": {"type": "string", "minLength": 2},
    "candidate_id": {"type": "string", "minLength": 1},
    "result_count": {"type": "integer", "minimum": 0},
    "reviewed_reference_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "verified_urls": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uri"}},
    "coverage_limitations": {"type": "string", "minLength": 4},
    "claim_id": {"type": "string", "pattern": "^I[1-9][0-9]*$"},
    "limitation_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^I[1-9][0-9]*-L[1-9][0-9]*$"}
    },
    "search_scope": {
      "enum": ["claim_combination", "distinguishing_limitation"]
    }
  },
  "additionalProperties": false
}
