{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Patent Engineering Reference Proposals",
  "type": "object",
  "required": ["case_revision", "proposals"],
  "properties": {
    "case_revision": {"type": "integer", "minimum": 0},
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "proposal_id", "candidate_id", "design_gap_question_id", "status", "problem", "summary", "inputs",
          "data_representation", "processing_steps", "decision_rules", "state_changes",
          "outputs", "boundary_handling", "conflict_handling", "integration_points",
          "technical_effect", "parameters", "source_feature_ids",
          "engineering_evidence_ids", "technical_disclosure_ids", "screening",
          "user_decision", "implementation", "commit_authorization", "origin_provenance"
        ],
        "properties": {
          "proposal_id": {"type": "string", "pattern": "^SP[0-9]{3,}$"},
          "candidate_id": {"type": "string", "pattern": "^P[0-9]{3,}$"},
          "design_gap_question_id": {"type": "string", "pattern": "^Q[0-9]{3,}$"},
          "status": {
            "enum": [
              "proposed", "screened", "adopted", "modified", "rejected",
              "uncertain", "high_overlap_rejected", "implemented"
            ]
          },
          "problem": {"type": "string", "minLength": 8},
          "summary": {"type": "string", "minLength": 8},
          "inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
          "data_representation": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
          "processing_steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
          "decision_rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
          "state_changes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
          "outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
          "boundary_handling": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
          "conflict_handling": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
          "integration_points": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
          "technical_effect": {"type": "string", "minLength": 4},
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "value", "provenance", "rationale"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "value": {},
                "provenance": {"enum": ["EVIDENCE_BACKED", "USER_CONFIRMED", "PROPOSED_DEFAULT"]},
                "rationale": {"type": "string", "minLength": 4}
              },
              "additionalProperties": false
            }
          },
          "source_feature_ids": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^F[0-9]{3,}$"}
          },
          "engineering_evidence_ids": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^E[0-9]{3,}$"}
          },
          "technical_disclosure_ids": {
            "type": "array", "uniqueItems": true,
            "items": {"type": "string", "pattern": "^TD[0-9]{3,}$"}
          },
          "screening": {
            "type": "object",
            "required": ["status", "search_record_ids", "overlap_risk", "conclusion", "patent_distinction_eligible"],
            "properties": {
              "status": {"enum": ["pending", "completed"]},
              "search_record_ids": {
                "type": "array", "uniqueItems": true,
                "items": {"type": "string", "pattern": "^S[0-9]+$"}
              },
              "overlap_risk": {"enum": ["unknown", "low", "medium", "high"]},
              "conclusion": {"type": "string"},
              "patent_distinction_eligible": {"type": "boolean"}
            },
            "additionalProperties": false
          },
          "user_decision": {
            "type": "object",
            "required": ["decision", "source", "decided_at"],
            "properties": {
              "decision": {"enum": ["pending", "adopt", "modify", "reject", "uncertain"]},
              "source": {"type": ["string", "null"]},
              "decided_at": {"type": ["string", "null"], "format": "date-time"}
            },
            "additionalProperties": false
          },
          "implementation": {
            "type": "object",
            "required": ["authorized", "authorization_source", "authorization_purpose", "status"],
            "properties": {
              "authorized": {"type": "boolean"},
              "authorization_source": {"type": ["string", "null"]},
              "authorization_purpose": {
                "type": ["string", "null"],
                "enum": [null, "patent_distinction", "real_engineering_value"]
              },
              "status": {"enum": ["not_requested", "pending", "validated", "failed"]}
            },
            "additionalProperties": false
          },
          "commit_authorization": {
            "type": "object",
            "required": ["authorized", "authorization_source", "status", "commit_sha"],
            "properties": {
              "authorized": {"type": "boolean"},
              "authorization_source": {"type": ["string", "null"]},
              "status": {"enum": ["not_requested", "authorized", "committed"]},
              "commit_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{7,64}$"}
            },
            "additionalProperties": false
          },
          "origin_provenance": {
            "type": "object",
            "required": ["origin_type", "human_contributions", "source", "inventorship_review_required"],
            "properties": {
              "origin_type": {"enum": ["agent_proposed", "human_proposed", "jointly_developed"]},
              "human_contributions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["contributor_ref", "contribution", "source"],
                  "properties": {
                    "contributor_ref": {"type": "string", "minLength": 1},
                    "contribution": {"type": "string", "minLength": 4},
                    "source": {"type": "string", "minLength": 2}
                  },
                  "additionalProperties": false
                }
              },
              "source": {"type": "string", "minLength": 2},
              "inventorship_review_required": {"const": true}
            },
            "additionalProperties": false
          },
          "redesign_of": {"type": ["string", "null"], "pattern": "^SP[0-9]{3,}$"},
          "redesign_basis": {"type": ["string", "null"]},
          "redesign_change_type": {
            "type": ["string", "null"],
            "enum": [null, "substantive_mechanism"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
